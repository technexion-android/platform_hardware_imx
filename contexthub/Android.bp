cc_binary {
    name: "android.hardware.contexthub-service.imx",
    defaults: [
        "//system/chre:contexthub_hal_defaults",
        "//system/chre:pw_rpc_cflags_chre",
        "//system/chre:pw_rpc_nanopb_lib_dependencies",
        "chre_aidl_hal_imx_defaults",
    ],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "//system/chre:imx_contexthub_hal_common_srcs",
        "aidl/imx_context_hub_aidl.cc",
        "aidl/service.cc",
    ],
    init_rc: ["aidl/android.hardware.contexthub-service.imx.rc"],
    vintf_fragments: ["aidl/android.hardware.contexthub-service.imx.xml"],
    visibility: ["//visibility:public"],
}

cc_defaults {
    name: "chre_aidl_hal_imx_defaults",
    vendor: true,
    include_dirs: [
        "system/chre/host/hal_generic/common/",
        "system/chre/util/include",
    ],
    cflags: [
        "-DCHRE_HAL_SOCKET_METRICS_ENABLED",
        "-DCHRE_IS_HOST_BUILD",
        "-DCHRE_MESSAGE_TO_HOST_MAX_SIZE=4000", // Needed to import CHRE APIs.
        "-DLOG_TAG=\"IMX_CONTEXTHUB_HAL\"",
        "-DLOG_NDEBUG=1",
        "-Wall",
        "-Werror",
    ],
    header_libs: [
        "chre_api",
    ],
    shared_libs: [
        "android.frameworks.stats-V2-ndk",
        "android.hardware.contexthub-V4-ndk",
        "chre_atoms_log",
        "chremetrics-cpp",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libjsoncpp",
        "liblog",
        "libprotobuf-cpp-lite",
        "libutils",
        "server_configurable_flags",
        "libaconfig_storage_read_api_cc",
    ],
    static_libs: [
        "chre_client",
        "chre_config_util",
        "chre_flags_c_lib",
        "chre_metrics_reporter",
        "event_logger",
    ],
}

